# homelab-starter settings. The menus write this file for you; edit it by hand and re-run
# `sudo ./install.sh` if you prefer. Values here are examples.

# Bundles to install (dependencies are added automatically). See bundles/ for the list:
# media-server movies-tv subtitles media-cleanup books games smart-home zigbee cameras dns
# monitoring backup sync remote-tailscale remote-cloudflare   (core + downloads are automatic)
BUNDLES='media-server movies-tv subtitles'

TZ='Europe/Dublin'
PUID='1000'            # your user id (id -u)
PGID='1001'            # group shared by all apps; created as 'media' if missing
DATA='/data'           # media root: movies, tv, books, roms live under here
# Optional per-type locations (each must keep downloads/ and library/ on one disk):
DATA_MOVIES=''
DATA_TV=''
DATA_BOOKS=''
DATA_ROMS=''
DATA_PHOTOS=''         # photos bundle: Immich originals (default $DATA/photos)
DATA_MUSIC=''          # music bundle: library + downloads (default $DATA/music)
APPDATA='/srv/appdata' # app settings (small; back this up)
ADMIN_USER='admin'     # one admin login for every app; the password is generated into $APPDATA/.secrets.env

GPU='auto'             # auto | none
ZIGBEE_DEVICE=''       # /dev/serial/by-id/... or tcp://IP:6638 (zigbee bundle)
REMOTE='none'          # none | tailscale | cloudflare
TS_AUTHKEY=''          # tailscale: optional auth key
CF_DOMAIN=''           # cloudflare: your domain
CF_TUNNEL_TOKEN=''     # cloudflare: tunnel token
CF_API_TOKEN=''        # cloudflare: optional API token for routes + Access
BACKUP_TARGET=''       # backup: destination folder
